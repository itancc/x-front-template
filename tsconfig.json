{
  "compilerOptions": {
    "jsx": "preserve",
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"],
      "@api/*": ["./src/api/*"],
      "@assets/*": ["./src/assets/*"],
      "#/*": ["./types/*"]
    },
    "types": ["vite/client"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "build/**/*.ts",
    "unocss.config.ts",
    "vite.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
